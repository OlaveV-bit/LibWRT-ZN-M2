CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_qihoo_360v6=y

CONFIG_NSS_FIRMWARE_VERSION_11_4=y

# ================= 无 WiFi 版本（硬件已去 WiFi） =================
# 关闭无线协议栈，避免生成 hostapd / wpa_supplicant / ath11k 等无线组件
CONFIG_PACKAGE_kmod-cfg80211=n
CONFIG_PACKAGE_kmod-mac80211=n

# 关闭 IPQ6018 的 ath11k 无线驱动与固件
CONFIG_PACKAGE_kmod-ath=n
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=n

# 关闭 NSS 的 WiFi Mesh 加速模块（无 WiFi 时无用）
CONFIG_PACKAGE_kmod-qca-nss-drv-wifi-meshmgr=n

# 关闭各类 hostapd / wpad 变体（target.mk 默认会塞 wpad-openssl）
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-basic-wolfssl=n
CONFIG_PACKAGE_wpad-mbedtls=n
CONFIG_PACKAGE_wpad-wolfssl=n
CONFIG_PACKAGE_hostapd-common=n
CONFIG_PACKAGE_hostapd=n
CONFIG_PACKAGE_hostapd-mini=n
CONFIG_PACKAGE_wpa-supplicant=n
CONFIG_PACKAGE_wpa-supplicant-openssl=n
CONFIG_PACKAGE_iw=n
CONFIG_PACKAGE_iw-full=n
